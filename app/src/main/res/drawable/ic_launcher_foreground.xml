<!-- 云文件夹透明前景在 108dp 画布中居中显示，留出桌面遮罩的裁切空间。
  88dp 为包含原稿透明留白的图层尺寸，主体保持在中心安全区域。
  规范：https://developer.android.com/develop/ui/compose/system/icon_design_adaptive -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:width="88dp" android:height="88dp" android:gravity="center">
    <bitmap
        android:src="@drawable/ic_launcher_glass"
        android:gravity="fill"
        android:filter="true" />
  </item>
</layer-list>
