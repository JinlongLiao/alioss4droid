# ---------------------------------------------------------------------------
# alioss4droid release signing (sample)
#
# 将本文件复制为 `keystore.properties` 并填入你的发布密钥信息。
# 不要把真实的 `keystore.properties` 或 `.jks` 文件提交到 git。
# 相关条目已在 `.gitignore` 中忽略。
#
# 生成命令示例（Windows PowerShell 或任意终端均可）：
#   keytool -genkeypair -v ^
#     -keystore alioss4droid-release.jks ^
#     -keyalg RSA -keysize 2048 -validity 36500 ^
#     -alias alioss4droid ^
#     -storetype PKCS12
# ---------------------------------------------------------------------------

# Keystore 文件的路径。相对路径相对于项目根目录（本文件所在目录）。
storeFile=alioss4droid-release.jks

# Keystore 密码
storePassword=CHANGE_ME

# Key alias 与密码
keyAlias=alioss4droid
keyPassword=CHANGE_ME

# ---------------------------------------------------------------------------
# （可选）debug 构建专用 keystore
#
# 填了下面四项就会用自建的 debug keystore 给 debug APK 签名，便于团队/测试机
# 固定指纹（集成微信、钉钉、高德等 SDK 的测试环境）。留空则回退到 AGP 自动生成的
# ~/.android/debug.keystore。
# ---------------------------------------------------------------------------
debugStoreFile=alioss4droid-debug.jks
debugStorePassword=CHANGE_ME
debugKeyAlias=alioss4droid-debug
debugKeyPassword=CHANGE_ME
