root = true

# 通用默认
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin / Java
[*.{kt,kts,java}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_name_count_to_use_star_import = 5
ij_kotlin_name_count_to_use_star_import_for_members = 3

# Gradle / Groovy
[*.{gradle,groovy}]
indent_size = 4

# TOML（Gradle Version Catalog）
[*.toml]
indent_size = 2

# 标记语言 / 配置
[*.{xml,yml,yaml,json,md}]
indent_size = 2

# Shell 脚本
[*.sh]
indent_size = 2
end_of_line = lf

# Windows 批处理
[*.{bat,cmd}]
end_of_line = crlf

# Makefile 必须 tab
[Makefile]
indent_style = tab
