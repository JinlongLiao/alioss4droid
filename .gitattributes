# 默认文本按操作系统换行检出，提交时统一 LF
* text=auto eol=lf

# Windows 脚本必须 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Shell / 构建脚本强制 LF
*.sh      text eol=lf
gradlew   text eol=lf

# 明确的文本类型（避免被误判为二进制）
*.kt      text
*.kts     text
*.java    text
*.xml     text
*.json    text
*.yml     text
*.yaml    text
*.toml    text
*.md      text
*.properties text
*.cfg     text
*.ini     text

# 源代码统计 / diff 行为
*.md       linguist-detectable=true
docs/**    linguist-documentation=true

# 常见二进制（防止 diff 污染 / 防止被 autocrlf 破坏）
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.tgz      binary
*.jar      binary
*.aar      binary
*.apk      binary
*.aab      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.keystore binary
*.jks      binary
